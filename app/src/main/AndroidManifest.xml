<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to pick the Wi-Fi network explicitly (bypasses VPN for LAN router calls) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 16+ Local Network Protection: without this, connections to LAN IPs
         (the router!) are silently dropped and look like connect timeouts -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Optional app lock (Settings → Security) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Background monitoring notifications (Settings → Мониторинг), opt-in and
         API 33+ only requires a runtime prompt; harmless to declare unconditionally -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        usesCleartextTraffic is intentional: the app communicates only with a
        user-configured LAN router IP (private network, set at runtime in Settings).
        No public-internet cleartext requests are made.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DomainManager"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DomainManager.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Actions / Assistant capability mapping (see xml/shortcuts.xml) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Headless automation endpoint: routerdomains://add?domain=X fires
             action=add and shows only a toast (Tasker / App Actions). The setup
             host is deliberately NOT registered — QR setup is parsed only by the
             in-app scanner so a random link can't overwrite credentials. -->
        <activity
            android:name=".ui.DeepLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DomainManager.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="routerdomains"
                    android:host="add" />
            </intent-filter>
        </activity>

        <!-- Share target: appears in the system share sheet for URLs and text from any browser -->
        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/html" />
            </intent-filter>
        </activity>

        <!-- Persists the in-app language choice across restarts on Android 12 and below -->
        <service
            android:name="androidx.appcompat.app.AppCompatDelegate$AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Home-screen widget: 4 service status dots, refreshed on the widget's
             own 30-min schedule via a WorkManager one-time job -->
        <receiver
            android:name=".widget.ServicesWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_services_info" />
        </receiver>

        <!-- Optional Quick Settings tile -->
        <service
            android:name=".tile.DomainQsTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
