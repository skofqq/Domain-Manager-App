<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted prefs: the Keystore key is device-bound, restoring the
             ciphertext to another device would be unreadable anyway. -->
        <exclude domain="sharedpref" path="domain_manager_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="domain_manager_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
